FROM python:3.12-slim
WORKDIR /app
COPY requirements-clustering.txt /app/requirements-clustering.txt
RUN pip install --no-cache-dir -r /app/requirements-clustering.txt
COPY clustering_api /app/clustering_api
EXPOSE 8000
CMD ["uvicorn", "clustering_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
